{
  "nodes": [
    {
      "parameters": {
        "path": "/handoff-request",
        "options": {},
        "method": "POST"
      },
      "id": "webhook-trigger",
      "name": "Handoff Request Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -300,
        200
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "session-id",
              "name": "sessionId",
              "value": "={{ $json.body.sessionId }}",
              "type": "string"
            },
            {
              "id": "chatbot-id",
              "name": "chatbotId", 
              "value": "={{ $json.body.chatbotId }}",
              "type": "string"
            },
            {
              "id": "user-identifier",
              "name": "userIdentifier",
              "value": "={{ $json.body.userIdentifier }}",
              "type": "string"
            },
            {
              "id": "reason",
              "name": "reason",
              "value": "={{ $json.body.reason }}",
              "type": "string"
            },
            {
              "id": "timestamp",
              "name": "timestamp",
              "value": "={{ $json.body.timestamp }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "process-handoff-data",
      "name": "Process Handoff Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -100,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE chat_sessions SET metadata = COALESCE(metadata, '{}'::jsonb) || '{\"support_requested\": true, \"handoff_reason\": \"{{ $json.reason }}\", \"handoff_timestamp\": \"{{ $json.timestamp }}\"}' WHERE id = '{{ $json.sessionId }}'",
        "options": {}
      },
      "id": "update-session-db",
      "name": "Update Session in Database",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        100,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "5LPqoPG4p0V8EFcd",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "authentication": "oAuth2Api",
        "resource": "message",
        "operation": "send",
        "chatId": "@support_team_channel",
        "text": "🚨 Human Support Requested\n\n📋 **Session Details:**\n• Session ID: {{ $json.sessionId }}\n• Chatbot ID: {{ $json.chatbotId }}\n• User: {{ $json.userIdentifier }}\n• Reason: {{ $json.reason }}\n• Time: {{ $json.timestamp }}\n\n👉 [View Chat in Dashboard](http://localhost:3000/dashboard/chats/{{ $json.sessionId }})",
        "additionalFields": {}
      },
      "id": "notify-support-team",
      "name": "Notify Support Team",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        300,
        200
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-credentials",
          "name": "Support Bot Telegram"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"success\": true,\n  \"message\": \"Handoff request processed successfully\",\n  \"sessionId\": \"{{ $('Process Handoff Data').item.json.sessionId }}\",\n  \"timestamp\": \"{{ $('Process Handoff Data').item.json.timestamp }}\"\n}",
        "options": {}
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        500,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"success\": false,\n  \"error\": \"{{ $json.error?.message || 'Failed to process handoff request' }}\",\n  \"sessionId\": \"{{ $('Process Handoff Data').item.json.sessionId }}\"\n}",
        "options": {
          "responseCode": "500"
        }
      },
      "id": "respond-error",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        500,
        400
      ]
    }
  ],
  "connections": {
    "Handoff Request Webhook": {
      "main": [
        [
          {
            "node": "Process Handoff Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Handoff Data": {
      "main": [
        [
          {
            "node": "Update Session in Database",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Session in Database": {
      "main": [
        [
          {
            "node": "Notify Support Team",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Support Team": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 0,
  "updatedAt": "2024-12-19T10:00:00.000Z",
  "versionId": "1"
}
