# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Chat Widget Configuration
NEXT_PUBLIC_CHAT_WIDGET_URL=http://localhost:3001

# Facebook API Configuration
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_GRAPH_API_BASE_URL=https://graph.facebook.com
FACEBOOK_API_VERSION=v18.0

# n8n Webhook URLs for workflows
N8N_UPLOAD_DOC_WEBHOOK_URL=http://localhost:5678/webhook/upload-doc
N8N_UPLOAD_URL_WEBHOOK_URL=http://localhost:5678/webhook/upload-url
NEXT_PUBLIC_N8N_RAG_CHAT_WEBHOOK_URL=http://localhost:5678/webhook/rag-chat

